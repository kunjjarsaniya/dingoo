# ====================================================
# Dingoo (https://dingoo.vercel.app) Environment Setup
# ====================================================

# --- FRONTEND (Vercel Environment Variables) ---
# Point to your deployed WebSocket backend server (e.g. Render, Railway, VPS)
NEXT_PUBLIC_SOCKET_URL=https://your-backend-service.onrender.com

# --- BACKEND (Render / Railway / VPS Environment Variables) ---
PORT=4000
DATABASE_URL=postgresql://user:password@host:5432/dingoo?sslmode=require
ALLOWED_ORIGINS=http://localhost:3000,https://dingoo.vercel.app,https://*.vercel.app
ROOM_TTL_HOURS=24
COUNTDOWN_SECONDS=3
LOG_LEVEL=info
